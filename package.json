{
  "name": "routini",
  "version": "1.1.0",
  "private": true,
  "description": "Routini PWA with web push reminders",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "web-push": "^3.6.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@playwright/test": "^1.56.1",
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "scripts": {
    "test": "npm run lint && npm run typecheck && npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "lint": "biome lint .",
    "typecheck": "tsc -p tsconfig.json"
  }
